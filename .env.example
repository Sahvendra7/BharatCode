# Copy to .env.local and fill in. Never commit real keys.

# Required for AI features. Get one at https://bharatcode.ai/account
# (free for verified students, or a Lite/Pro plan). Server-side only.
BHARATCODE_API_KEY=

# Optional. Defaults shown.
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1

# Optional. Analyses allowed per IP per 10 minutes (default 8).
TURANT_RATE_LIMIT_PER_10_MIN=8
